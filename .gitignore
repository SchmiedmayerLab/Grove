# Swift Package Manager
Package.resolved
*.xcodeproj
# Ignore .swiftpm, but keep shared schemes (e.g. the Grove-Tests test-plan host scheme) tracked.
.swiftpm/*
!.swiftpm/xcode
.swiftpm/xcode/*
!.swiftpm/xcode/xcshareddata
.swiftpm/xcode/xcshareddata/*
!.swiftpm/xcode/xcshareddata/xcschemes
# Track only the Grove-Tests host scheme; ignore the per-target schemes Xcode auto-generates.
.swiftpm/xcode/xcshareddata/xcschemes/*
!.swiftpm/xcode/xcshareddata/xcschemes/Grove-Tests.xcscheme
.build
.xcodebuild
.derivedData*
coverage.lcov
*.xcresult

# IDE related folders
.idea
.vscode

# Xcode User settings
xcuserdata/

# Other files
.DS_Store
.env

# Documentation generation
*.doccarchive
docs/

# UITests Project
!UITests.xcodeproj
# ...but not the inner workspace Xcode creates inside the xcodeproj upon opening it (user state only; not part of the generated projects).
project.xcworkspace/

__pycache__/

# local working clones for the monorepo migration
.incoming/

# local clone of the grove-fhir guides used by Scripts/validate-fhir-conformance.sh
.fhir/

# Shared SwiftPM bare-repo cache used by Scripts/run-package-tests.sh
.packageCache/
.derivedData-periphery/
