%{
# Locates the resolved apple/FHIRModels checkout and collects every concrete ModelsR4 type that
# carries a settable `extension: [Extension]?` property -- i.e. exactly the set of types the
# `_FHIRTypeWithExtensions` protocol on the `lukaskollmer/FHIRModels` fork unified.
#
# Why this exists: FHIRModels 0.9.0 turned `Element`/`DomainResource` from classes into protocols.
# You cannot retroactively conform a protocol to another protocol, so the pre-0.9.0 approach
# (`extension ModelsR4.Element: FHIRTypeWithExtensions {}`) no longer compiles. Upstream SpeziFHIR #47
# solved this by adding `_FHIRTypeWithExtensions` *inside* a FHIRModels fork -- but a released package
# cannot depend on a fork branch (SwiftPM rejects a stable-version package depending on a
# branch/revision requirement). So we recreate the protocol locally and generate a conformance for
# every concrete type instead. Conforming a foreign type to a protocol we own needs no `@retroactive`.
#
# Regenerate with `./useGYB` from the repo root (requires `swift package resolve` to have run first).

import os, re, glob

# NOTE: gyb chdir's to the template's own directory, so anchor every path on __file__ rather than
# on the cwd -- a relative path here silently resolves against Sources/FHIRModelsExtensions and can
# pick up an unrelated (e.g. stale DerivedData) FHIRModels checkout, producing a wrong-but-valid file.
_repo_root = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "../.."))

def _find_models_r4():
    candidates = [
        os.environ.get("FHIRMODELS_SOURCES"),
        os.path.join(_repo_root, ".build/checkouts/FHIRModels/Sources/ModelsR4"),
        os.path.join(_repo_root, ".derivedData/SourcePackages/checkouts/FHIRModels/Sources/ModelsR4"),
    ]
    for c in candidates:
        if c and os.path.isdir(c):
            return c
    raise RuntimeError(
        "Could not locate the FHIRModels ModelsR4 sources. Run `swift package resolve` first, "
        "or set FHIRMODELS_SOURCES to the ModelsR4 source directory."
    )

_r4 = _find_models_r4()
_decl = re.compile(r"public (?:struct|final class)\s+(\w+)(?:<[^>]*>)?\s*:")
_prop = re.compile(r"var `extension`: \[Extension\]\?")

types = set()
for _path in sorted(glob.glob(os.path.join(_r4, "*.swift"))):
    with open(_path, "r", encoding="utf-8") as fh:
        _src = fh.read()
    for _m in _decl.finditer(_src):
        _start = _m.start()
        _next = _src.find("\npublic ", _start + 1)
        _body = _src[_start: _next if _next > 0 else len(_src)]
        if _prop.search(_body):
            types.add(_m.group(1))

types = sorted(types)
}%

// NOTE: This file was automatically generated by `./useGYB` from FHIR+ExtensionUtils.swift.gyb and should not be edited.
// swiftlint:disable all

public import ModelsR4


/// A FHIR type that supports extensions.
///
/// - Note: Types outside this package shouldn't declare conformances to this protocol; rather, it is used to provide a
///   range of FHIR Extension-related operations on all FHIR types that carry extensions.
public protocol FHIRTypeWithExtensions {
    /// Additional content defined by implementations.
    var `extension`: [Extension]? { get set }
}


// MARK: Retrieval

extension FHIRTypeWithExtensions {
    /// Retrieves all FHIR Extensions for the specified url.
    @inlinable
    public func extensions(for url: FHIRPrimitive<FHIRURI>) -> [Extension] {
        `extension`.map { $0.filter { $0.url == url } } ?? []
    }

    /// Retrieves all FHIR Extensions for the specified url.
    @inlinable
    public func extensions(for url: FHIRExtensionURL) -> [Extension] {
        extensions(for: url.r4)
    }
}


// MARK: Appending

/// Controls extension appending
public enum AppendExtensionBehaviour {
    /// Adding an extension does not affect existing extensions with the same URL, instead the new value simply gets appended.
    case additive
    /// Adding an extension causes all other existing extensions with the same URL to be removed.
    case replace
}


extension FHIRTypeWithExtensions {
    /// Appends an `Extension`
    ///
    /// - parameter extension: The extension to add
    /// - parameter behaviour: How the extension should be added, with respect to already-existing extensions with the same url.
    @inlinable
    public mutating func append(extension: Extension, behaviour: AppendExtensionBehaviour = .additive) {
        append(extensions: CollectionOfOne(`extension`), behaviour: behaviour)
    }

    /// Appends multiple `Extension`s
    @inlinable
    public mutating func append(extensions: some Sequence<Extension>, behaviour: AppendExtensionBehaviour = .additive) {
        switch behaviour {
        case .additive:
            break
        case .replace:
            for element in extensions {
                removeAllExtensions(withUrl: element.url)
            }
        }
        var storage = `extension` ?? []
        storage.reserveCapacity(storage.count + extensions.underestimatedCount)
        storage.append(contentsOf: extensions)
        `extension` = storage
    }
}


// MARK: Removal

extension FHIRTypeWithExtensions {
    /// Removes the first extension that matches the specified url.
    ///
    /// - returns: the removed extension element, if any.
    @inlinable @discardableResult
    public mutating func removeFirstExtension(withUrl url: FHIRPrimitive<FHIRURI>) -> Extension? {
        guard var elements = `extension`, let idx = elements.firstIndex(where: { $0.url == url }) else {
            return nil
        }
        let element = elements.remove(at: idx)
        `extension` = elements.isEmpty ? nil : elements
        return element
    }

    /// Removes the first extension that matches the specified url.
    ///
    /// - returns: the removed extension element, if any.
    @inlinable @discardableResult
    public mutating func removeFirstExtension(withUrl url: FHIRExtensionURL) -> Extension? {
        removeFirstExtension(withUrl: url.r4)
    }

    /// Removes all extension that matches the specified url.
    ///
    /// - returns: the removed extension elements, if any.
    @inlinable @discardableResult
    public mutating func removeAllExtensions(withUrl url: FHIRPrimitive<FHIRURI>) -> [Extension]? {
        guard var elements = `extension` else {
            return nil
        }
        let removedElements = elements.filter { $0.url == url }
        elements.removeAll { $0.url == url }
        `extension` = elements.isEmpty ? nil : elements
        return removedElements
    }

    /// Removes all extension that matches the specified url.
    ///
    /// - returns: the removed extension elements, if any.
    @inlinable @discardableResult
    public mutating func removeAllExtensions(withUrl url: FHIRExtensionURL) -> [Extension]? {
        removeAllExtensions(withUrl: url.r4)
    }
}


// MARK: Conformances

// ${len(types)} ModelsR4 types carry a settable `extension` property.
// (`FHIRPrimitive` is generic and appears here too; one extension covers every instantiation.)
% for type in types:
extension ModelsR4.${type}: FHIRTypeWithExtensions {}
% end
